# Copy to .env (git-ignored) and edit. run.sh loads it before starting the server.
# Every line is optional; the values shown are the defaults.

# ---- This LLM server ----
# 0.0.0.0 = reachable from the LAN (the Windows client connects to this machine's
# LAN IP, e.g. 192.168.0.192:8100). 127.0.0.1 = this machine only.
SERVER_BIND_IP=0.0.0.0
SERVER_PORT=8100

# ---- Ollama (runs the models, normally on this machine) ----
OLLAMA_URL=http://localhost:11434
DEFAULT_MODEL=gemma4:31b

# ---- Speech to text (the GUI's mic button) ----
# auto = local Whisper if faster-whisper is installed, else Google (internet); off = disabled
STT_ENGINE=auto
# Empty = large-v3-turbo on the GPU, small on the CPU. Others: tiny, base, medium, large-v3
STT_MODEL=
# auto tries the GPU, then the CPU
STT_DEVICE=auto
# 1 = load the Whisper model when the server starts instead of on the first clip
STT_PRELOAD=0

# ---- Text to speech (the GUI's Play buttons) ----
# Used when a chat picks "Server default": edge (online) or piper (offline)
TTS_ENGINE=edge
TTS_VOICE=en-US-JennyNeural
# Piper voices (.onnx + .onnx.json); empty = Server/ollama/voices
TTS_PIPER_DIR=
# Engines to load at start-up: kokoro downloads its model here the first time
TTS_PRELOAD=kokoro
# Languages Chatterbox offers (any of: ar da de el en es fi fr he hi it ja ko ms nl no pl pt ru sv sw tr zh)
TTS_CHATTERBOX_LANGUAGES=en,zh,ja

# ---- Pictures (ComfyUI on this machine) ----
# Chats pick a workflow in Chat Settings; workflows are ComfyUI "Export (API)" .json files
COMFYUI_URL=http://127.0.0.1:8188
# Empty = Server/ollama/workflows
COMFYUI_WORKFLOW_DIR=
# Seconds one picture may take
COMFYUI_TIMEOUT=300
# Pictures one reply may ask for
COMFYUI_MAX_IMAGES=2
# One GPU for Ollama and ComfyUI? 1 = unload the chat model before drawing, so both fit
COMFYUI_UNLOAD_OLLAMA=0
# 1 = ComfyUI frees its models after each picture
COMFYUI_FREE_AFTER=0

# ---- NAS (Samba; recorded for later, nothing uses it yet) ----
NAS_IP=192.168.0.163
NAS_MOUNT=/mnt/nas

# Mercury power tool (tools/mercury.py, see IoT/README.md)
ESP_API_URL=
ESP_API_TOKEN=
MERCURY_MAC=
